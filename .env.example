# Copy to .env and adjust. docker compose reads this file automatically.

# How the site is exposed: "caddy" (HTTPS on ports 80/443) or "tunnel"
# (Cloudflare Tunnel, no port forwarding).
COMPOSE_PROFILES=tunnel
DOMAIN=chess.akkerman.ai
# Token from `terraform output -raw tunnel_token` in infra/ (see infra/README.md).
CLOUDFLARE_TUNNEL_TOKEN=

# Shared code you give to friends. Needed to fetch games and start analyses;
# anyone with a link can still view a finished analysis. Leave empty for an
# open site.
ACCESS_CODE=

# Search depth per position. 16 reliably catches tactical blunders; each
# search is stopped after ANALYSIS_MAX_TIME seconds even if it is not done.
# To search a fixed time instead, set ANALYSIS_DEPTH=0 and ANALYSIS_TIME=0.5.
ANALYSIS_DEPTH=16
ANALYSIS_MAX_TIME=15
# Engine threads per worker. Empty: all cores but one (3 on a Pi 4/5), so the
# system stays responsive. The engine also runs at lower priority (nice 10).
STOCKFISH_THREADS=
STOCKFISH_HASH=128
ENGINE_NICE=10
# Number of games analysed at the same time. Keep 1 on a Raspberry Pi.
WORKERS=1
MAX_QUEUE=20

# Only used when you build the image yourself (docker compose up --build):
# endgame tablebases to include, full (940 MB), wdl (380 MB) or none.
SYZYGY=full

# Opening theory comes from the opening book in the image. This explorer is
# only used if the book is missing: lichess, masters or none.
OPENING_EXPLORER=lichess
# Personal token from https://lichess.org/account/oauth/token, if the
# explorer asks for authentication.
LICHESS_TOKEN=

# Optional: a language model that rewords move explanations like a coach.
# The plain explanations work without it. Any OpenAI-compatible API works;
# for Ollama on the Pi itself, add "coach" to COMPOSE_PROFILES (e.g.
# COMPOSE_PROFILES=tunnel,coach) and pull the model once (see
# docker-compose.yml). qwen2.5:1.5b needs about 1 GB of memory.
COACH_URL=
COACH_MODEL=
COACH_API_KEY=
# Seconds to wait for the model before showing the plain explanation.
COACH_TIMEOUT=60
